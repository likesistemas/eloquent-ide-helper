{
    "name": "likesistemas/eloquent-ide-helper",
    "type": "library",
    "description": "Using `barryvdh/laravel-ide-helper` without laravel framework.",
    "require": {
        "php": ">=7.4",
        "barryvdh/laravel-ide-helper": "^2.13 || ^3.0",
        "illuminate/filesystem": "^8.0 || ^10.0 || ^12.0 ",
        "illuminate/container": "^8.0 || ^10.0 || ^12.0",
        "doctrine/dbal": "^3.0 || ^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "likesistemas/eloquent-external": "^2.1",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.1",
        "symplify/easy-coding-standard": "^12.5",
        "php-parallel-lint/php-parallel-lint": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Like\\Eloquent\\IdeHelper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Like\\Eloquent\\IdeHelper\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/ide-helper"],
    "authors": [
        {
            "name": "Like Sistemas",
            "email": "dev@likesistemas.com.br",
            "homepage": "https://www.likesistemas.com.br/"
        }
    ],
    "scripts": {
        "fix": "ecs --fix",
        "fix:ci": "ecs",
        "test": "phpunit",
        "lint": "parallel-lint --exclude .git --exclude vendor .",
        "refactor": "rector",
        "refactor:ci": "rector --dry-run",
        "analyse": "phpstan analyse",
        "analyse:baseline": "phpstan analyse --generate-baseline",
        "models:refresh": "ide-helper models"
    },
    "config": {
        "allow-plugins": {
            "kylekatarnls/update-helper": true
        }
    }
}
